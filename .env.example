# Copy to .env and fill in before `npm run build`.
VITE_SITE_URL=https://mypdffix.com
# Optional: true excludes a non-production build from search indexing.
# Cloudflare branches other than main are excluded automatically.
VITE_NOINDEX=
# Contact address is fixed to mypdffix@gmail.com in SiteConfigContext.
# A stale hosting VITE_CONTACT_EMAIL value cannot override it.
# The owner-approved AdSense publisher is set in scripts/adsense.mjs.
# Vite uses that same ID for the verification loader, client code and ads.txt.
VITE_GA_ID=
VITE_GTM_ID=
VITE_CLARITY_ID=
