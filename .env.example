# Copy to .env and fill in before `npm run build`.
VITE_SITE_URL=https://mypdffix.com
# Optional: true excludes a non-production build from search indexing.
# Cloudflare branches other than main are excluded automatically.
VITE_NOINDEX=
VITE_CONTACT_EMAIL=mypdffix@gmail.com
# Google AdSense publisher ID, e.g. ca-pub-1234567890123456 (also written to ads.txt)
VITE_ADSENSE_ID=
VITE_GA_ID=
VITE_GTM_ID=
VITE_CLARITY_ID=
